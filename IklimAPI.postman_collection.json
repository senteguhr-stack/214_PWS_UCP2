{
  "info": {
    "name": "IklimAPI",
    "description": "Koleksi request untuk testing IklimAPI - SaaS data cuaca Indonesia",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "jwt_token", "value": "" },
    { "key": "api_key", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Budi Santoso\",\n  \"email\": \"budi@mail.com\",\n  \"password\": \"rahasia123\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"budi@mail.com\",\n  \"password\": \"rahasia123\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": { "raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "API Keys",
      "item": [
        {
          "name": "List Keys",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": { "raw": "{{base_url}}/api/keys", "host": ["{{base_url}}"], "path": ["api", "keys"] }
          }
        },
        {
          "name": "Create Key",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"label\": \"Server Produksi\"\n}" },
            "url": { "raw": "{{base_url}}/api/keys", "host": ["{{base_url}}"], "path": ["api", "keys"] }
          }
        },
        {
          "name": "Toggle Key",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": { "raw": "{{base_url}}/api/keys/:id/toggle", "host": ["{{base_url}}"], "path": ["api", "keys", ":id", "toggle"] }
          }
        },
        {
          "name": "Delete Key",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": { "raw": "{{base_url}}/api/keys/:id", "host": ["{{base_url}}"], "path": ["api", "keys", ":id"] }
          }
        }
      ]
    },
    {
      "name": "Data (v1)",
      "item": [
        {
          "name": "List Cities",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{api_key}}" }],
            "url": { "raw": "{{base_url}}/api/v1/cities?limit=20", "host": ["{{base_url}}"], "path": ["api", "v1", "cities"], "query": [{ "key": "limit", "value": "20" }] }
          }
        },
        {
          "name": "Get City by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{api_key}}" }],
            "url": { "raw": "{{base_url}}/api/v1/cities/1", "host": ["{{base_url}}"], "path": ["api", "v1", "cities", "1"] }
          }
        },
        {
          "name": "List Weather",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{api_key}}" }],
            "url": { "raw": "{{base_url}}/api/v1/weather?city_id=1&limit=10", "host": ["{{base_url}}"], "path": ["api", "v1", "weather"], "query": [{ "key": "city_id", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        },
        {
          "name": "Get Weather by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{api_key}}" }],
            "url": { "raw": "{{base_url}}/api/v1/weather/1", "host": ["{{base_url}}"], "path": ["api", "v1", "weather", "1"] }
          }
        },
        {
          "name": "City Weather Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{api_key}}" }],
            "url": { "raw": "{{base_url}}/api/v1/weather/stats/1", "host": ["{{base_url}}"], "path": ["api", "v1", "weather", "stats", "1"] }
          }
        }
      ]
    }
  ]
}
