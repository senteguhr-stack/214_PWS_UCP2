# Salin file ini menjadi .env dan isi dengan nilai asli Anda

# Koneksi Database (Supabase PostgreSQL)
# Ambil dari Supabase Dashboard > Project Settings > Database > Connection String (URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# JWT
JWT_SECRET=ganti_dengan_string_rahasia_yang_panjang_dan_acak
JWT_EXPIRES_IN=7d

# Server
PORT=3000
